# deploy/.env olarak kopyala; .env repoya GİRMEZ (.gitignore).
# Denetim kaydındaki metin özetinin tuzu. Üret: openssl rand -hex 32
KALKAN_DENETIM_TUZ=
# Alan adı (DuckDNS) ve Let's Encrypt bildirim e-postası (sertifika sorunlarında haber verir)
KALKAN_ALAN_ADI=
KALKAN_ACME_EPOSTA=
# Caddy arkasında 1. API'yi Caddy'siz doğrudan açarsan 0 yap: X-Forwarded-For taklidiyle hız sınırı aşılamasın.
KALKAN_GUVENILIR_VEKIL=1
KALKAN_LIMIT_DAKIKA=10
KALKAN_LIMIT_GUN=200
